// FPEval 리소스 (UTF-8)
#pragma code_page(65001)
#include <winres.h>
#include "resource.h"

LANGUAGE LANG_KOREAN, SUBLANG_DEFAULT

/////////////////////////////////////////////////////////////////////////////
// 아이콘

// 가장 작은 ID의 아이콘이 탐색기·작업 표시줄의 exe 아이콘이 된다
IDR_MAINFRAME ICON "FPEval.ico"

/////////////////////////////////////////////////////////////////////////////
// 메인 대화상자
// 왼쪽 사이드바(CNavBar) + 오른쪽 페이지 제목·설명 + 페이지 영역(흰 패널) + 아래 실행 막대.
// 페이지는 IDC_PAGE_AREA 자리에 겹쳐 놓고 하나만 보인다.

IDD_FPEVAL DIALOGEX 0, 0, 580, 296
STYLE DS_SETFONT | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU | WS_MINIMIZEBOX | WS_MAXIMIZEBOX | WS_THICKFRAME | WS_CLIPCHILDREN
EXSTYLE WS_EX_APPWINDOW
CAPTION "FPEval — 지문인식 알고리즘 평가 프로그램"
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    CONTROL         "", IDC_NAV, "Static", SS_NOTIFY | WS_TABSTOP, 0, 0, 112, 296
    LTEXT           "", IDC_PAGE_TITLE, 120, 7, 452, 14
    LTEXT           "", IDC_PAGE_DESC, 120, 23, 452, 9
    LTEXT           "", IDC_PAGE_AREA, 120, 37, 452, 200, NOT WS_VISIBLE

    // 실행 제어 (왼쪽). 평가 시작은 강조 버튼(CAccentButton)
    PUSHBUTTON      "▶  평가 시작", IDC_START, 120, 246, 68, 16, BS_OWNERDRAW
    PUSHBUTTON      "중지", IDC_STOP, 192, 246, 40, 16
    PUSHBUTTON      "강제 종료", IDC_ABORT, 236, 246, 48, 16
    PUSHBUTTON      "이어하기…", IDC_RESUME, 288, 246, 50, 16
    // 결과 (오른쪽)
    PUSHBUTTON      "리포트만 생성…", IDC_REPORT_ONLY, 406, 246, 62, 16
    PUSHBUTTON      "리포트 열기", IDC_OPEN_REPORT, 472, 246, 50, 16
    PUSHBUTTON      "결과 폴더", IDC_OPEN_FOLDER, 526, 246, 46, 16

    CONTROL         "", IDC_PROGRESS, "msctls_progress32", 0x0, 120, 269, 452, 5
    LTEXT           "대기 중", IDC_STATUS, 120, 279, 452, 9
END

// 창 크기를 바꿀 때 컨트롤이 움직이는 방식은 CMainDlg::SetupLayout()에서 컨트롤 ID로 지정한다
// (사이드바를 접으면 위치가 바뀌므로 리소스 순서 기반 AFX_DIALOG_LAYOUT 대신 코드로 다시 만든다).

/////////////////////////////////////////////////////////////////////////////
// 실행 현황 (대시보드). 위쪽 상태 문구·수치 카드·단계 표시는 CDashPage::OnPaint가 그린다.

IDD_PAGE_DASH DIALOGEX 0, 0, 450, 196
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    LTEXT           "실행 로그", IDC_DASH_LOG_LABEL, 10, 96, 100, 10
    LISTBOX         IDC_LOG, 10, 108, 430, 82, LBS_NOINTEGRALHEIGHT | LBS_NOSEL | WS_VSCROLL | WS_HSCROLL
END

IDD_PAGE_DASH AFX_DIALOG_LAYOUT
BEGIN
    0,
    0, 0, 0, 0,        // IDC_DASH_LOG_LABEL
    0, 0, 100, 100     // IDC_LOG
END

IDD_PAGE_RESULTS DIALOGEX 0, 0, 450, 244
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD | WS_CLIPCHILDREN
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    PUSHBUTTON      "폴더 추가(&A)…", IDC_RESULTS_ADD, 9, 8, 68, 16
    PUSHBUTTON      "새로 고침(&R)", IDC_RESULTS_REFRESH, 81, 8, 65, 16
    CONTROL         "", IDC_RESULTS_LIST, "SysListView32", LVS_REPORT | LVS_SINGLESEL | LVS_SHOWSELALWAYS | WS_TABSTOP, 9, 32, 258, 184
    LTEXT           "선택한 리포트", IDC_RESULTS_HEADING, 277, 12, 164, 12
    CONTROL         "", IDC_RESULTS_DETAIL, "Edit", ES_MULTILINE | ES_READONLY | ES_AUTOVSCROLL | WS_VSCROLL | WS_TABSTOP, 277, 32, 164, 184
    LTEXT           "", IDC_RESULTS_STATUS, 9, 225, 320, 12
    PUSHBUTTON      "HTML 열기(&H)", IDC_RESULTS_HTML, 285, 221, 73, 16
    PUSHBUTTON      "Word 열기(&W)", IDC_RESULTS_DOCX, 368, 221, 73, 16
    PUSHBUTTON      "선택(&S)", IDC_RESULTS_SELECT, 368, 221, 73, 16, NOT WS_VISIBLE
    PUSHBUTTON      "파일 찾아보기(&F)…", IDC_RESULTS_FILE, 150, 8, 83, 16, NOT WS_VISIBLE
    CONTROL         "완료된 실행 포함", IDC_RESULTS_COMPLETED, "Button", BS_AUTOCHECKBOX | WS_TABSTOP | NOT WS_VISIBLE, 153, 11, 96, 12
END

/////////////////////////////////////////////////////////////////////////////
// 탭 1: 대상

IDD_PAGE_TARGET DIALOGEX 0, 0, 450, 196
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    GROUPBOX        "평가 대상", IDC_STATIC, 6, 2, 438, 88
    LTEXT           "알고리즘 DLL", IDC_STATIC, 14, 18, 68, 10
    EDITTEXT        IDC_DLL, 85, 15, 295, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기", IDC_DLL_BROWSE, 384, 15, 52, 14
    LTEXT           "", IDC_DLL_INFO, 85, 30, 351, 9

    LTEXT           "테스트 DB 폴더", IDC_STATIC, 14, 45, 68, 10
    EDITTEXT        IDC_DB, 85, 42, 295, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기", IDC_DB_BROWSE, 384, 42, 52, 14
    LTEXT           "", IDC_DB_INFO, 85, 57, 351, 9

    LTEXT           "iType", IDC_STATIC, 14, 72, 68, 10
    EDITTEXT        IDC_ITYPE, 85, 69, 30, 14, ES_NUMBER
    LTEXT           "FVC2000=1, FVC2002=2, FVC2004=3", IDC_STATIC, 122, 72, 314, 10

    GROUPBOX        "저장 위치", IDC_STATIC, 6, 94, 438, 98
    LTEXT           "결과 폴더", IDC_STATIC, 14, 108, 68, 10
    EDITTEXT        IDC_OUT, 85, 105, 295, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기", IDC_OUT_BROWSE, 384, 105, 52, 14

    LTEXT           "템플릿 저장 폴더", IDC_STATIC, 14, 125, 68, 10
    EDITTEXT        IDC_TPL, 85, 122, 295, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기", IDC_TPL_BROWSE, 384, 122, 52, 14

    LTEXT           "리포트 저장 폴더", IDC_STATIC, 14, 142, 68, 10
    EDITTEXT        IDC_REPDIR, 85, 139, 295, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기", IDC_REPDIR_BROWSE, 384, 139, 52, 14

    LTEXT           "로그 저장 폴더", IDC_STATIC, 14, 159, 68, 10
    EDITTEXT        IDC_LOGDIR, 85, 156, 295, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기", IDC_LOGDIR_BROWSE, 384, 156, 52, 14
    LTEXT           "템플릿·리포트·로그 경로 미지정 시 결과 폴더에 저장", IDC_STATIC, 85, 173, 351, 16
END

/////////////////////////////////////////////////////////////////////////////
// 탭 2: 시험 규칙

IDD_PAGE_RULES DIALOGEX 0, 0, 450, 196
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    GROUPBOX        "비교 조합", IDC_STATIC, 6, 2, 438, 82
    LTEXT           "등록 규칙", IDC_STATIC, 14, 16, 68, 10
    COMBOBOX        IDC_ENROLL, 85, 13, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "순번", IDC_STATIC, 235, 16, 25, 10
    EDITTEXT        IDC_ENROLL_IDX, 262, 13, 35, 14, ES_NUMBER

    LTEXT           "본인비교 조합", IDC_STATIC, 14, 33, 68, 10
    COMBOBOX        IDC_GEN, 85, 30, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "N", IDC_STATIC, 235, 33, 25, 10
    EDITTEXT        IDC_GEN_N, 262, 30, 45, 14, ES_NUMBER

    LTEXT           "타인비교 조합", IDC_STATIC, 14, 50, 68, 10
    COMBOBOX        IDC_IMP, 85, 47, 140, 80, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "N", IDC_STATIC, 235, 50, 25, 10
    EDITTEXT        IDC_IMP_N, 262, 47, 45, 14, ES_NUMBER
    LTEXT           "순번 목록", IDC_STATIC, 318, 50, 40, 10
    EDITTEXT        IDC_IMP_IDX, 360, 47, 76, 14, ES_AUTOHSCROLL

    CONTROL         "타인비교 대칭 쌍 제거 ((a,b)와 (b,a) 중 하나만)", IDC_IMP_SYM, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 85, 66, 300, 10

    GROUPBOX        "재현성", IDC_STATIC, 6, 88, 438, 32
    LTEXT           "seed", IDC_STATIC, 14, 103, 68, 10
    EDITTEXT        IDC_SEED, 85, 100, 90, 14, ES_NUMBER
    PUSHBUTTON      "새 seed", IDC_SEED_NEW, 180, 100, 45, 14
    LTEXT           "동일한 seed 사용 시 조합·실행 순서 동일", IDC_STATIC, 232, 103, 204, 10

    GROUPBOX        "부분 평가", IDC_STATIC, 6, 124, 438, 42
    LTEXT           "쌍 목록 파일", IDC_STATIC, 14, 139, 68, 10
    EDITTEXT        IDC_PAIRS, 85, 136, 295, 14, ES_AUTOHSCROLL
    PUSHBUTTON      "찾아보기", IDC_PAIRS_BROWSE, 384, 136, 52, 14
    LTEXT           "파일 지정 시 조합 규칙 대신 파일 내 쌍(enroll, attempt, type)만 평가", IDC_STATIC, 85, 152, 351, 10

    LTEXT           "", IDC_ESTIMATE, 10, 170, 430, 22
END

/////////////////////////////////////////////////////////////////////////////
// 탭 3: 실행 옵션

IDD_PAGE_RUN DIALOGEX 0, 0, 450, 196
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    GROUPBOX        "병렬 실행", IDC_STATIC, 6, 2, 438, 50
    LTEXT           "동시 수행 수", IDC_STATIC, 14, 18, 68, 10
    EDITTEXT        IDC_WORKERS, 85, 15, 30, 14, ES_NUMBER
    LTEXT           "", IDC_CPU_INFO, 122, 18, 314, 10

    LTEXT           "timeout (초)", IDC_STATIC, 14, 35, 68, 10
    EDITTEXT        IDC_TIMEOUT, 85, 32, 30, 14, ES_NUMBER
    LTEXT           "함수 호출 시간 초과 시 TIMEOUT 기록 및 Worker 강제 종료", IDC_STATIC, 122, 35, 314, 10

    GROUPBOX        "규칙 유추 차단", IDC_STATIC, 6, 56, 438, 30
    CONTROL         "Worker 전달 파일명을 일련번호로 치환해 시험 규칙 유추 차단", IDC_ANON, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 70, 422, 10

    GROUPBOX        "Worker 프로세스 격리", IDC_STATIC, 6, 90, 438, 69
    LTEXT           "격리 상태", IDC_STATIC, 14, 105, 68, 10
    LTEXT           "DLL을 별도 프로세스에서 실행", IDC_STATIC, 85, 105, 351, 10
    LTEXT           "예정 Worker", IDC_STATIC, 14, 120, 68, 10
    LTEXT           "", IDC_WORKER_INFO, 85, 120, 351, 10
    LTEXT           "DLL 비정상 종료·응답 시간 초과 시 CRASH·TIMEOUT 기록\nDLL 비트 수에 맞는 Worker 자동 선택", IDC_STATIC, 14, 135, 422, 20
END

/////////////////////////////////////////////////////////////////////////////
// 탭 4: 리포트
// 지표 체크박스는 3열로 배치한다(Tab 순서는 행 단위). ID(IDC_ITEM0 + n)는 Pages.cpp의 항목 순서와 같다.

IDD_PAGE_REPORT DIALOGEX 0, 0, 450, 196
STYLE DS_SETFONT | DS_CONTROL | WS_CHILD
FONT 9, "맑은 고딕", 400, 0, 0x81
BEGIN
    GROUPBOX        "성능 지표", IDC_STATIC, 6, 2, 438, 70
    CONTROL         "FTE (등록 실패율)", IDC_ITEM0 + 0, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 16, 136, 10
    CONTROL         "ZeroFMR", IDC_ITEM0 + 4, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 156, 16, 136, 10
    CONTROL         "FMR10000", IDC_ITEM0 + 14, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 298, 16, 138, 10
    CONTROL         "REJ genuine/impostor", IDC_ITEM0 + 1, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 29, 136, 10
    CONTROL         "ZeroFNMR", IDC_ITEM0 + 5, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 156, 29, 136, 10
    CONTROL         "Enrollment/Matching time", IDC_ITEM0 + 8, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 298, 29, 138, 10
    CONTROL         "EER", IDC_ITEM0 + 2, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 42, 136, 10
    CONTROL         "FMR100", IDC_ITEM0 + 6, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 156, 42, 136, 10
    CONTROL         "Template size", IDC_ITEM0 + 9, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 298, 42, 138, 10
    CONTROL         "EER*", IDC_ITEM0 + 3, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 55, 136, 10
    CONTROL         "FMR1000", IDC_ITEM0 + 7, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 156, 55, 136, 10
    CONTROL         "오류 목록", IDC_ITEM0 + 13, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 298, 55, 138, 10

    GROUPBOX        "그래프 (SVG·EMF 벡터 파일로도 저장)", IDC_STATIC, 6, 76, 438, 30
    CONTROL         "DET Curve", IDC_ITEM0 + 10, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 14, 90, 136, 10
    CONTROL         "Score Distribution", IDC_ITEM0 + 11, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 156, 90, 136, 10
    CONTROL         "FMR(t)·FNMR(t)", IDC_ITEM0 + 12, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 298, 90, 138, 10

    GROUPBOX        "리포트 형식 · 계산 방식", IDC_STATIC, 6, 110, 438, 48
    LTEXT           "형식", IDC_STATIC, 14, 125, 68, 10
    CONTROL         "HTML", IDC_HTML, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 85, 124, 60, 10
    CONTROL         "MS-Word (.docx)", IDC_DOCX, "Button", BS_AUTOCHECKBOX | WS_TABSTOP, 150, 124, 90, 10

    LTEXT           "EER 방식", IDC_STATIC, 14, 141, 68, 10
    COMBOBOX        IDC_EER_METHOD, 85, 138, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    LTEXT           "FMR/FNMR 분모", IDC_STATIC, 205, 141, 60, 10
    COMBOBOX        IDC_DENOM, 268, 138, 100, 60, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
END

